# ── AI API Keys ──────────────────────────────────────────
# Gemini API Key (Required for AI Interview Engine, Gemini 2.0 Brain)
# Get a free key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# APILayer Resume Parser (For ATS resume evaluation)
# Get a free key: https://apilayer.com/marketplace/resume_parser-api
APILAYER_API_KEY=your_apilayer_api_key_here

# Judge0 Code Execution (Optional - for online code compilation)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_rapidapi_key_here

# ── Session & Limits ─────────────────────────────────────
MAX_QUESTIONS_PER_SESSION=15
SESSION_TIMEOUT_MINUTES=90
