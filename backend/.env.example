# ── AI API Keys ───────────────────────────────────────────────────────────────
# MODULE 3 — /start greeting & resume parsing  → Gemini (1M context, $0)
# Get a free key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MODULE 1 — evaluate_answer()   → Groq gpt-oss-120B  (~1s, $0)
# MODULE 2 — get_next_question() → Groq llama-3.1-8b  (~0.3s, $0)
# MODULE 5 — transcribe_audio()  → Groq Whisper       (~200ms, $0)
# Get a free key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# MODULE 4 — generate_report()   → OpenRouter nemotron-ultra (frontier, $0)
# Get a free key: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MODULE 6 — Emergency 429 failover → SambaNova gemma-4-31b-it ($0)
# Get a free key: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# OpenAI API Key (Optional legacy fallback)
OPENAI_API_KEY=your_openai_api_key_here

# APILayer Resume Parser (For ATS resume evaluation)
# Get a free key: https://apilayer.com/marketplace/resume_parser-api
APILAYER_API_KEY=your_apilayer_api_key_here

# ── Per-Module Model Overrides (optional — defaults shown) ────────────────────
MODEL_EVALUATE=openai/gpt-oss-120b
MODEL_QUESTION=llama-3.1-8b-instant
MODEL_GREETING=gemini-2.5-flash-lite-preview-06-17
MODEL_REPORT=nvidia/nemotron-ultra-253b-v1:free
MODEL_WHISPER=whisper-large-v3-turbo
MODEL_FAILOVER=gemini-2.0-flash-lite

# ── Session & Limits ──────────────────────────────────────────────────────────
MAX_QUESTIONS_PER_SESSION=15
SESSION_TIMEOUT_MINUTES=90
